# ─────────────────────────────────────────────────────────────────
# SwarmFrame — server-side configuration (never bundled into the browser)
# Copy to .env and fill in ONE provider key. No key = demo mode.
# ─────────────────────────────────────────────────────────────────

# Claude (recommended) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override model tiers (defaults shown)
# CLAUDE_MODEL_HEAVY=claude-opus-5     # Cortex, Sentinel, Synth, Critic
# CLAUDE_MODEL_FAST=claude-sonnet-5    # Muse, Looper, CODEX + UPE judges

# Gemini (alternative) — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL_HEAVY=gemini-2.5-pro
# GEMINI_MODEL_FAST=gemini-2.5-flash

# Force a provider: anthropic | gemini | mock
# (use LLM_PROVIDER=anthropic with an `ant auth login` profile and no key)
# LLM_PROVIDER=

# Production server port (npm start)
# PORT=8787
