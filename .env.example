# ─────────────────────────────────────────────────────────────────
# SwarmFrame — server-side config (never bundled into the browser).
# Copy to .env. With nothing set, a running Ollama is auto-detected;
# otherwise the app runs in demo mode.
# ─────────────────────────────────────────────────────────────────

# ── Option 1: Ollama — free, local, private (auto-detected) ──────
#   ollama pull llama3.1:8b && ollama serve
# OLLAMA_MODEL=llama3.1:8b          # used for every node
# OLLAMA_MODEL_HEAVY=qwen3:14b      # optional: Cortex/Sentinel/Synth/Critic
# OLLAMA_MODEL_FAST=llama3.1:8b     # optional: Muse/Looper + CODEX/UPE judges
# OLLAMA_NUM_CTX=16384              # context window; Ollama's default truncates
# OLLAMA_BASE_URL=http://localhost:11434

# ── Option 2: Groq — free tier, very fast open models ────────────
#   key: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL_HEAVY=llama-3.3-70b-versatile
# GROQ_MODEL_FAST=llama-3.1-8b-instant

# ── Option 3: OpenRouter — ":free" open models ───────────────────
#   key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Option 4: any OpenAI-compatible server (LM Studio, vLLM…) ────
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=local-model
# OPENAI_API_KEY=

# ── Also supported: GEMINI_API_KEY (free tier), ANTHROPIC_API_KEY ─

# Force a provider instead of auto-detecting:
#   ollama | groq | openrouter | openai | gemini | anthropic | mock
# LLM_PROVIDER=

# Production server port (npm start)
# PORT=8787
